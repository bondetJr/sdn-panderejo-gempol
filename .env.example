# =====================================================
# SDN PANDEREJO GEMPOL — ENVIRONMENT VARIABLES
# Copy file ini ke .env lalu isi dengan kredensial asli.
# JANGAN commit file .env ke Git.
# =====================================================

# --- Database (Supabase Postgres) ---
# Ambil dari Supabase Dashboard > Project Settings > Database > Connection string (URI, mode: Transaction/Pooler untuk app, Direct untuk migrate)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- Supabase (Storage & Auth) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# --- NextAuth ---
AUTH_SECRET="generate-dengan: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# --- Chat AI "Ceria" (Anthropic API) ---
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxx"

# --- Enkripsi PII (NIK, No. HP Orang Tua) ---
# WAJIB 32 byte. Generate MASING-MASING dengan perintah terpisah
# (jangan pakai nilai yang sama untuk keduanya):
#   openssl rand -base64 32
PII_ENCRYPTION_KEY="ganti-dengan-hasil-openssl-rand--base64-32"
PII_HASH_KEY="ganti-dengan-hasil-openssl-rand--base64-32-yang-berbeda"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
